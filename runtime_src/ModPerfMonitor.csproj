<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「Mod 性能监测器」Mod —— 托管运行时程序集。

    刻意不用 Godot.NET.Sdk（要联网还原包 + 源码生成器）；本入口只用
    Godot 普通 API 和游戏程序集的公开成员（全部逻辑走 SceneTree 信号通道）。

    ★ 引用目录 = 当前的 0.30.0 构建（DesktopNew\植物大战僵尸杂交版0.30）。
      其它 Mod 仍指向 Downloads 的 0.29 目录 —— 本 Mod 用到 0.30 新增 API
      （XWModExtensions / XWModContentCatalog.GetContentOwner 等），必须按 0.30 编译；
      所有 0.30 专有调用都做了存在性探测 + try/catch，在 0.29 上会降级而不是崩。

    入口程序集身份名用唯一名 JTYModPerfMonitor（安卓要求主程序集名唯一），
    打包环节会改名为 ModAssembly.dll 放进包内 Runtime/。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>JTYModPerfMonitor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>2.2.1</Version>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <FileVersion>2.2.1.0</FileVersion>
    <!-- 压掉 MSB3277 版本冲突警告（否则构建日志膨胀、耗时变长） -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- 引用目录由 build_mod.py 以 -p:GodotRefDir=<本机游戏本体> 注入（换机器只改 mods/_modenv.py） -->
    <GodotRefDir Condition="'$(GodotRefDir)' == ''"></GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 收款码共享组件：QrCodeBitmap 现场生成 37×37 码；SponsorQrInjector 把码插进配置页「关于」栏 -->
    <Compile Include="..\..\QrCodeBitmap.cs" Link="QrCodeBitmap.cs" />
    <Compile Include="..\..\SponsorQrInjector.cs" Link="SponsorQrInjector.cs" />
    <Compile Remove="check_*.cs" />
    <None Include="check_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false：游戏程序集不进输出，运行时由引擎自己那份解析 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
